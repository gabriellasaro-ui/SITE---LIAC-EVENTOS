# URL pública do site (sem barra no final). Usada em canonical, sitemap, OG e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://liaceventos.com.br

# Google Tag Manager. Deixe vazio para desativar.
NEXT_PUBLIC_GTM_ID=

# Webhook que recebe os leads do formulário (CRM, n8n, Zapier, Make, RD Station...).
# Recebe um POST JSON. Se vazio, o lead segue apenas pelo WhatsApp.
LEAD_WEBHOOK_URL=

# Webhook das candidaturas do "Trabalhe conosco". Se vazio, usa o LEAD_WEBHOOK_URL;
# se os dois estiverem vazios, a candidatura segue pelo WhatsApp.
CAREERS_WEBHOOK_URL=

# Verificação do Google Search Console (só o código do content="...").
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Porta do servidor onde o container fica exposto (docker-compose). Dentro do container é sempre 3000.
HOST_PORT=3001
